# ---------------------------------------------------------------------
# dir-dashboard — variaveis de ambiente do backend
# Copie para .env e preencha. NUNCA comite o .env.
# ---------------------------------------------------------------------

# Banco de dados local (MySQL 8.0)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/dir_dashboard

# Chave de assinatura dos tokens JWT.
# Gere uma sequencia aleatoria longa. Em producao a TI define a chave.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-por-uma-sequencia-aleatoria-longa

# Tempo de vida do token de acesso, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origens liberadas no CORS (separadas por virgula)
CORS_ORIGINS=http://localhost:3000

# development | production
ENVIRONMENT=development

# Senha dos usuarios criados por "make seed-fake".
# Use o padrao interno da KAMI CO. para ambientes de teste — consulte o
# guia de onboarding ou a TI. Nao registre o valor neste arquivo.
SEED_SENHA_PADRAO=
